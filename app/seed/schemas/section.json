{
  "type": "object",
  "properties": {
    "score": {"type": "number", "description": "1 to 4 in steps of 0.5"},
    "level_signal": {"type": "string", "enum": ["below_senior", "senior", "staff", "senior_staff_plus"]},
    "summary": {"type": "string"},
    "evidence": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {"quote": {"type": "string"}, "observation": {"type": "string"}},
        "required": ["quote", "observation"]
      }
    },
    "strengths": {"type": "array", "items": {"type": "string"}},
    "gaps": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "tag": {"type": "string"},
          "description": {"type": "string"},
          "why_it_matters_at_staff": {"type": "string"},
          "what_a_staff_answer_sounds_like": {"type": "string"},
          "severity": {"type": "string", "enum": ["low", "medium", "high"]}
        },
        "required": ["tag", "description", "why_it_matters_at_staff", "what_a_staff_answer_sounds_like", "severity"]
      }
    },
    "interviewer_followups": {"type": "array", "items": {"type": "string"}},
    "concepts_to_study": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {"concept": {"type": "string"}, "why": {"type": "string"}, "resource": {"type": "string"}},
        "required": ["concept", "why", "resource"]
      }
    },
    "fact_checks": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "claim": {"type": "string"},
          "verdict": {"type": "string", "enum": ["correct", "partially_correct", "incorrect"]},
          "explanation": {"type": "string"},
          "url": {"type": "string"}
        },
        "required": ["claim", "verdict", "explanation"]
      }
    },
    "notes_for_candidate": {"type": "string"},
    "sources": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {"title": {"type": "string"}, "url": {"type": "string"}},
        "required": ["title", "url"]
      }
    }
  },
  "required": ["score", "level_signal", "summary", "evidence", "strengths", "gaps", "interviewer_followups", "concepts_to_study", "fact_checks", "sources"]
}
