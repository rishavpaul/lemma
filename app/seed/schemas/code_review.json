{
  "type": "object",
  "properties": {
    "verdict_kind": {
      "type": "string",
      "enum": [
        "wrong",
        "correct_slow",
        "correct_optimal"
      ],
      "description": "What the judge results and the reference approach say about this solution"
    },
    "overall_score": {
      "type": "number",
      "description": "1-4 in half steps, staff = 3"
    },
    "overall_level": {
      "type": "string",
      "enum": [
        "below_senior",
        "senior",
        "staff",
        "senior_staff_plus"
      ]
    },
    "hire_signal": {
      "type": "string",
      "enum": [
        "strong_no",
        "lean_no",
        "lean_hire",
        "strong_hire"
      ]
    },
    "summary": {
      "type": "string",
      "description": "3-5 sentences: is it correct, is it the expected approach, and the biggest thing between this and a staff answer"
    },
    "dimension_scores": {
      "type": "object",
      "properties": {
        "correctness": {
          "$ref": "#/$defs/dim"
        },
        "algorithm_and_complexity": {
          "$ref": "#/$defs/dim"
        },
        "code_quality": {
          "$ref": "#/$defs/dim"
        },
        "design_and_extensibility": {
          "$ref": "#/$defs/dim"
        },
        "production_awareness": {
          "$ref": "#/$defs/dim"
        },
        "communication": {
          "$ref": "#/$defs/dim"
        }
      },
      "required": [
        "correctness",
        "algorithm_and_complexity",
        "code_quality",
        "design_and_extensibility",
        "production_awareness",
        "communication"
      ]
    },
    "complexity": {
      "type": "object",
      "properties": {
        "your_time": {
          "type": "string"
        },
        "your_space": {
          "type": "string"
        },
        "optimal_time": {
          "type": "string"
        },
        "optimal_space": {
          "type": "string"
        },
        "note": {
          "type": "string",
          "description": "One or two sentences on where the cost comes from in the candidate's code"
        }
      },
      "required": [
        "your_time",
        "your_space",
        "optimal_time",
        "optimal_space",
        "note"
      ]
    },
    "strengths": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "comments": {
      "type": "array",
      "description": "The review as code-review comments on the candidate's code, most important first (at most 10). Bugs, performance problems, gaps to the staff bar and better ways to write it all go here, each pinned to the code it is about.",
      "items": {
        "type": "object",
        "properties": {
          "severity": {
            "type": "string",
            "enum": [
              "high",
              "medium",
              "low"
            ]
          },
          "kind": {
            "type": "string",
            "enum": [
              "bug",
              "performance",
              "staff_gap",
              "robustness",
              "clarity"
            ]
          },
          "title": {
            "type": "string",
            "description": "The point in a few words"
          },
          "comment": {
            "type": "string",
            "description": "What is wrong or missing and why it matters in an interview, 1-3 sentences, to the candidate"
          },
          "anchor": {
            "type": "string",
            "description": "The code this comment is about: copied EXACTLY from candidate_code (same characters and indentation), one to six consecutive lines or part of one line. Empty only for a comment about the whole solution."
          },
          "find": {
            "type": "string",
            "description": "For a suggested change: the exact text to replace, copied verbatim from candidate_code, contiguous and occurring exactly once (usually the same as anchor, or a few lines around it). Empty when the point is not a code change."
          },
          "replace": {
            "type": "string",
            "description": "The new code that replaces `find`, with the same indentation style. It must compile in place with the rest of the file and keep every test passing. Empty when `find` is empty."
          }
        },
        "required": [
          "severity",
          "kind",
          "title",
          "comment",
          "anchor",
          "find",
          "replace"
        ]
      }
    },
    "say_out_loud": {
      "type": "string",
      "description": "4-7 sentences a staff candidate would say aloud for this problem: clarifications, approach, complexity, tradeoffs, what is left out"
    },
    "interviewer_follow_ups": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "question": {
            "type": "string"
          },
          "strong_answer": {
            "type": "string",
            "description": "What a strong answer covers, in 1-3 sentences"
          }
        },
        "required": [
          "question",
          "strong_answer"
        ]
      }
    },
    "gaps": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "tag": {
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "severity": {
            "type": "string",
            "enum": [
              "high",
              "medium",
              "low"
            ]
          }
        },
        "required": [
          "tag",
          "description",
          "severity"
        ]
      }
    },
    "drill": {
      "type": "string",
      "description": "One concrete thing to practise next, tied to the biggest gap"
    },
    "redo_advice": {
      "type": "string",
      "description": "Whether and how to redo this problem (for example from scratch without the judge)"
    }
  },
  "required": [
    "verdict_kind",
    "overall_score",
    "overall_level",
    "hire_signal",
    "summary",
    "dimension_scores",
    "complexity",
    "strengths",
    "comments",
    "say_out_loud",
    "interviewer_follow_ups",
    "gaps",
    "drill",
    "redo_advice"
  ],
  "$defs": {
    "dim": {
      "type": "object",
      "properties": {
        "score": {
          "type": "number"
        },
        "assessed": {
          "type": "boolean"
        },
        "rationale": {
          "type": "string"
        }
      },
      "required": [
        "score",
        "assessed",
        "rationale"
      ]
    }
  }
}
